# Общие для Go-сервисов.
# APP_ENV=production включает JSON-логи, release-режим Gin и Secure-куки.
APP_ENV=development
LOG_LEVEL=info

# Postgres (один сервер, отдельная база на каждый микросервис)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=app
# базы, создаваемые при первой инициализации тома (deploy/postgres/init-databases.sh)
POSTGRES_MULTIPLE_DATABASES=users

# services/gateway — публичный API (Gin).
# API_PORT — порт, публикуемый docker compose; сам сервис слушает HTTP_PORT (по умолчанию 3001).
API_PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
AUTH_SERVICE_URL=http://localhost:8081
USERS_SERVICE_URL=http://localhost:8082

# services/auth (gateway проверяет сессию тем же JWT_SECRET)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h
# пароль для входа в админку
ADMIN_PASSWORD=change_me

# services/users
USERS_DB_NAME=users

# services/bot
BOT_TOKEN=your_telegram_bot_token_from_botfather

# apps/admin (Nuxt) - публичный URL API (gateway)
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001
ADMIN_PORT=3000

# apps/client (Nuxt) - публичный сайт
CLIENT_PORT=3002
NUXT_PUBLIC_SITE_URL=http://localhost:3002
NUXT_PUBLIC_BOT_URL=https://t.me/your_bot
